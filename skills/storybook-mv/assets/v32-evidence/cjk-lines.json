{
  "lines": [
    {
      "id": "line-001",
      "text": "窗边的灯还亮着"
    },
    {
      "id": "line-002",
      "text": "我带着微光往前走"
    },
    {
      "id": "line-003",
      "text": "雨落下时有人撑起伞"
    },
    {
      "id": "line-004",
      "text": "安静也能听见回答"
    },
    {
      "id": "line-005",
      "text": "把没说完的话留在桌上"
    },
    {
      "id": "line-006",
      "text": "下一次相遇仍有可能"
    }
  ]
}
